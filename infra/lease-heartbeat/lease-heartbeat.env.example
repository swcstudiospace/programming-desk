# desk-lease-heartbeat environment — template. The live file is
# /etc/desk-lease-heartbeat/heartbeat.env (root:root 0600, never committed).
#
# NAMES ONLY, every value empty. This is the INFRA half of SPE-4792: the names the unit reads and
# the file they live in. The heartbeat's *semantics* — what a lease is, when it expires, what a
# renewal means against an open claim — are SYSTEMS. See LEASE-HEARTBEAT.md §1 for the split.
#
# Empty TTL/interval means the unit refuses to start rather than guessing a cadence. A heartbeat
# that guesses its own TTL is a lease that expires at a time nobody agreed to.

# --- Identity ----------------------------------------------------------------
# Which seat this host is heartbeating for, e.g. bot-05-infrastructure.
LEASE_SEAT=
# Stable id for this heartbeat host, so two hosts renewing the same seat are distinguishable in
# the events plane instead of looking like one flapping writer.
LEASE_HOLDER_ID=

# --- Endpoint (the substrate; never a data plane directly) --------------------
# Loopback to substrate-mcp, matching SUBSTRATE_URL in infra/substrate/substrate.env.example.
LEASE_ENDPOINT_URL=
# Bearer minted for this unit alone. One consumer per token: a rotation here must not take the
# desk gateway down with it.
LEASE_ENDPOINT_TOKEN=

# --- Cadence (LEASE-HEARTBEAT.md §3) -----------------------------------------
# Lease lifetime in seconds. SYSTEMS owns the value; INFRA owns that the unit reads it from here.
LEASE_TTL_S=
# Renewal interval in seconds. The bound is on the SUM of three terms:
#   LEASE_INTERVAL_S + LEASE_JITTER_S + LEASE_TIMEOUT_S  <=  LEASE_TTL_S / 3
# so two consecutive misses do not expire a live lease: one missed tick is a network blip, three
# is a dead holder. Jitter and timeout are inside that bound, not added on top of it — the timer
# measures from when the previous renewal STARTED, so the next one's runtime lands on the gap.
LEASE_INTERVAL_S=
# Per-request timeout. Must be < LEASE_INTERVAL_S, or a hung request eats the next tick. The
# unit's TimeoutStartSec is generated from this at install time — a fixed literal there breaks
# the guarantee as soon as the interval drops below it.
LEASE_TIMEOUT_S=
# Consecutive failed renewals before the unit reports the lease lost and stops claiming it holds
# one. Reporting, not stealing: taking a lease from its holder is claim CAS, and that is SYSTEMS.
LEASE_MAX_MISSED=
# Randomised delay added to each tick, so N seats restarted together do not renew in lockstep.
# Generates the timer's RandomizedDelaySec, and counts against the interval bound above.
LEASE_JITTER_S=

# --- Lease sweeper: substrate-lease-reap.{service,timer} (LEASE-HEARTBEAT.md §6) ---
# One periodic call to the SYSTEMS-owned coord_reap_leases tool on the local substrate-mcp, so a
# dead holder's lease is still released on a quiet desk. INFRA schedules the call and does not
# implement the reap. NAMES ONLY here, as everywhere in this file.
#
# Loopback MCP endpoint. Never a tailnet or public host: the substrate is on this machine, and a
# sweeper that could reach another host's substrate is a sweeper that can reap another desk.
#   SUBSTRATE_MCP_URL=http://127.0.0.1:7410/mcp
SUBSTRATE_MCP_URL=
# Sweep cadence. Default 45, permitted 30-60 (the timer header explains the band). Note the _SEC
# suffix: it matches the SPE-4792 ticket's name for this variable, while the per-seat heartbeat
# above uses _S. Same unit, two spellings, both deliberate — do not "correct" either in place.
SUBSTRATE_LEASE_REAP_INTERVAL_SEC=
# Per-sweep timeout; must stay below the interval or a hung sweep occupies the next tick.
SUBSTRATE_LEASE_REAP_TIMEOUT_SEC=
# Path to a root:root 0600 curl config file holding the Authorization header line, and path to the
# JSON-RPC request body. Paths, not values: a bearer passed on the command line is visible in `ps`
# and in `systemctl show` to every local user, so it never becomes an Environment= line either.
# Both file contents are in LEASE-HEARTBEAT.md §6.
SUBSTRATE_LEASE_REAP_CURL_CONFIG=
SUBSTRATE_LEASE_REAP_REQUEST=

# --- Local state -------------------------------------------------------------
# Where the last successful renewal timestamp is recorded, for the drift probe to read without a
# network call. A file, not a database: the probe must work while the planes are unreachable.
LEASE_STATE_DIR=
LEASE_LOG_LEVEL=

# --- drift_scan inputs INFRA feeds (DRIFT-SCAN.md) ---------------------------
# Checkout the git-tip probe reads. Read-only: the probe never fetches, checks out or resets.
DRIFT_REPO_DIR=
DRIFT_GIT_REMOTE=
DRIFT_GIT_BRANCH=
# Comma-separated host:port list the reachability probe TCP-connects to. Connectivity only — no
# credentials, no queries. Typically the forwarder ports from ../railway/forwarders.yaml.
DRIFT_REACH_TARGETS=
# Per-target connect timeout, and how long a probe result may be reused before it is re-run.
# Seconds as a bare number, no unit suffix: the probe validates this before running anything and
# refuses a bad value, because an unvalidated one both breaks the JSON and makes every plane
# report as down.
DRIFT_PROBE_TIMEOUT_S=
DRIFT_CACHE_TTL_S=
# Bound on the git ls-remote lookup; defaults to DRIFT_PROBE_TIMEOUT_S, same format and same
# validation. ls-remote has no timeout of its own, and an unresponsive remote would otherwise
# stall the whole scan before the reachability half runs.
DRIFT_GIT_TIMEOUT_S=
