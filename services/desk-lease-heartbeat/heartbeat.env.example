# desk-lease-heartbeat — example environment. NAMES ONLY.
# Every value is empty except LEASE_TIMEOUT_S, whose default is 10.
#
# The live file is /etc/desk-lease-heartbeat/heartbeat.env (root:root 0600, never
# committed). INFRA writes that file and the systemd units. This example is the
# contract the entrypoint reads. Do not put a token, a bearer, or a host that is
# not a placeholder in this file.
#
# systemd EnvironmentFile format: KEY=VALUE, no shell expansion. The cron fallback
# passes it with `desk-lease-heartbeat renew --env-file <path>` so the entrypoint
# parses it the same way. `$`, backticks and quotes are literal data, not shell.

# --- Identity ----------------------------------------------------------------
# Seat this host renews for, e.g. bot-01-systems-backend. Logged. Not sent as a
# new field: graph_heartbeat has no seat argument.
LEASE_SEAT=
# Stable id of this heartbeat host, so two hosts for one seat are distinguishable
# in the journal. Logged. Not sent to the substrate.
LEASE_HOLDER_ID=

# --- Upstream ----------------------------------------------------------------
# Substrate MCP endpoint. Loopback, the same shape as SUBSTRATE_MCP_URL.
# Example shape (not a value): http://127.0.0.1:7410/mcp
# Either this or LEASE_ENDPOINT_TOKEN empty means the tick logs
# "upstream not configured" and exits 0. It does not guess an endpoint.
LEASE_ENDPOINT_URL=
# Bearer minted for this unit alone. Never logged. A 401 with both set is a
# real failure (exit 2), not the unconfigured path.
LEASE_ENDPOINT_TOKEN=

# --- Cadence -----------------------------------------------------------------
# Sent as graph_heartbeat ttl_seconds when set. Integer, 30..86400 (the
# substrate floor and the coordination-pack ceiling). Empty: omit ttl_seconds
# and let the substrate keep its own default. Invalid: exit 6.
# Also the right-hand side of the invariant below.
LEASE_TTL_S=
# Timer interval in seconds. This process does not sleep on it. Together with
# jitter and the overall timeout it must satisfy:
#   LEASE_INTERVAL_S + LEASE_JITTER_S + LEASE_TIMEOUT_S <= LEASE_TTL_S / 3
# and LEASE_TIMEOUT_S < LEASE_INTERVAL_S. When all four are set, a violation
# is exit 6. The 60s oneshot uses 60 here; systemd OnUnitActiveSec is INFRA's.
LEASE_INTERVAL_S=
# Randomised delay systemd adds to every tick. Counted in the invariant.
# This process does not sleep on it. Integer >= 0. The placeholder timer uses 5.
LEASE_JITTER_S=
# Overall budget for one `renew` run, in seconds. Not a per-lease timeout:
# every graph_heartbeat in the tick shares this one clock, and a lease that
# would start after it is spent is not sent. Positive integer.
# Default is 10. A 60s interval, 5s jitter and a 900s TTL satisfy the guard:
# 60 + 5 + 10 = 75 and 900 / 3 = 300, so 75 <= 300, and 10 < 60.
# INFRA generates the unit's TimeoutStartSec from this same number.
LEASE_TIMEOUT_S=10
# Consecutive real failures of one lease before this process drops it from
# held.json and stops claiming it. Positive integer. Empty means never drop
# on a count — only a substrate rejection (ok:false) drops a lease.
# Dropping is not stealing. The timer keeps running.
LEASE_MAX_MISSED=

# --- Local state -------------------------------------------------------------
# Directory for held.json, misses.json and last-renewal. A missing held.json
# is "nothing held" (exit 0), not an error.
LEASE_STATE_DIR=
# Optional override of the held-lease file. Empty means $LEASE_STATE_DIR/held.json.
LEASE_HELD_FILE=
# debug, info, warning, or error. Empty means info. The token and lease_id are
# omitted at every level.
LEASE_LOG_LEVEL=
# Cap on a failing response body copied into the journal, after redaction.
# Non-negative integer. Empty means 2000. A negative value is exit 6.
LEASE_LOG_BYTES=

# Names this file needs for desk-lease-heartbeat (reap and drift names in the
# same file are ignored by this process):
#   LEASE_SEAT
#   LEASE_HOLDER_ID
#   LEASE_ENDPOINT_URL
#   LEASE_ENDPOINT_TOKEN
#   LEASE_TTL_S
#   LEASE_INTERVAL_S
#   LEASE_JITTER_S
#   LEASE_TIMEOUT_S
#   LEASE_MAX_MISSED
#   LEASE_STATE_DIR
#   LEASE_HELD_FILE
#   LEASE_LOG_LEVEL
#   LEASE_LOG_BYTES
