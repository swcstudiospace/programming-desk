# desk-lease-heartbeat environment template. Values are blank on purpose.
# install.sh copies this file to /etc/desk-lease-heartbeat/heartbeat.env once, mode 0600,
# and never overwrites that live file. Do not put a token, a bearer, or a real host here.
#
# systemd EnvironmentFile format: KEY=VALUE, no shell expansion. Empty cadence values use
# the installer defaults: interval 60, jitter 5, timeout 10, TTL 900.
# Invariant (names only): timeout < interval, and interval + jitter + timeout <= TTL/3.
#
# The 13 names desk-lease-heartbeat reads (PR #221 / SPE-12499). Reap and drift names live in
# lease-heartbeat.env.example; this process ignores them. Append those on the host if the
# reap timer will be enabled — install.sh will not rewrite this file to add them later.

LEASE_SEAT=
LEASE_HOLDER_ID=
LEASE_ENDPOINT_URL=
LEASE_ENDPOINT_TOKEN=
LEASE_TTL_S=
LEASE_INTERVAL_S=
LEASE_JITTER_S=
LEASE_TIMEOUT_S=
LEASE_MAX_MISSED=
LEASE_STATE_DIR=
LEASE_HELD_FILE=
LEASE_LOG_LEVEL=
LEASE_LOG_BYTES=
