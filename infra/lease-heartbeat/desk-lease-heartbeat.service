# SPE-12501. Copied by install.sh. Not enabled unless install.sh is passed --enable.
#
# ExecStart is the SYSTEMS oneshot from PR #221 (SPE-12499): `desk-lease-heartbeat renew`.
# The VPS checkout is /opt/desk-gateway/programming-desk. Type=oneshot: the timer owns the
# cadence, not a sleep loop inside the process. A crashed oneshot is retried by the next tick;
# a crashed daemon with a sleep loop is a lease that silently stops renewing.

[Unit]
Description=Programming Desk seat lease heartbeat (SPE-12501)
Documentation=file:///opt/desk-gateway/programming-desk/infra/lease-heartbeat/LEASE-HEARTBEAT.md
After=network-online.target substrate-mcp.service
Wants=network-online.target
# The heartbeat talks to substrate-mcp over loopback. If the substrate is down the tick fails and
# is retried; it is not an ordering bug, so this is Wants-level, not Requires.

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/desk-gateway/programming-desk
# REQUIRED, with no `-` prefix: the `-` would let systemd start a renewal with no env file at all,
# so the unit would run with no seat, no holder id, no endpoint and no token — renewing nothing,
# succeeding quietly, and leaving the operator with a green timer and an expiring lease. A missing
# env file must fail the unit loudly instead.
EnvironmentFile=/etc/desk-lease-heartbeat/heartbeat.env
ExecStart=/opt/desk-gateway/programming-desk/services/desk-lease-heartbeat/.venv/bin/desk-lease-heartbeat renew
# Shipped literal. install.sh copies this file and does not rewrite it. 10 is the default
# LEASE_TIMEOUT_S. A non-empty LEASE_TIMEOUT_S other than 10 is refused, because systemd cannot
# read TimeoutStartSec from the EnvironmentFile. See LEASE-HEARTBEAT.md §3.
TimeoutStartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/desk-lease-heartbeat
StandardOutput=journal
StandardError=journal
SyslogIdentifier=desk-lease-heartbeat
