# STUB — not installed. SPE-4792 INFRA half.
#
# ExecStart points at a SYSTEMS-owned entrypoint that does not exist yet
# (services/** is bot-01-systems-backend). Nothing installs this unit: there is no install.sh in
# this directory on purpose, because a timer that fires a missing binary logs a failure every tick
# and teaches the operator to ignore the unit. Install once SYSTEMS lands the entrypoint.
#
# Paired with desk-lease-heartbeat.timer. Type=oneshot: the timer owns the cadence, not a sleep
# loop inside the process. A crashed oneshot is retried by the next tick; a crashed daemon with a
# sleep loop is a lease that silently stops renewing.

[Unit]
Description=Programming Desk seat lease heartbeat (SPE-4792)
Documentation=file:///opt/programming-desk/infra/lease-heartbeat/LEASE-HEARTBEAT.md
After=network-online.target substrate-mcp.service
Wants=network-online.target
# The heartbeat talks to substrate-mcp over loopback. If the substrate is down the tick fails and
# is retried; it is not an ordering bug, so this is Wants-level, not Requires.

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/programming-desk
# REQUIRED, with no `-` prefix: the `-` would let systemd start a renewal with no env file at all,
# so the unit would run with no seat, no holder id, no endpoint and no token — renewing nothing,
# succeeding quietly, and leaving the operator with a green timer and an expiring lease. A missing
# env file must fail the unit loudly instead.
EnvironmentFile=/etc/desk-lease-heartbeat/heartbeat.env
# STUB: SYSTEMS entrypoint, not yet present.
ExecStart=/opt/programming-desk/services/desk-lease-heartbeat/.venv/bin/desk-lease-heartbeat renew
# PLACEHOLDER — generate from LEASE_TIMEOUT_S at install time, the same way the timer's
# OnUnitActiveSec is generated from LEASE_INTERVAL_S. A fixed literal here is wrong as soon as
# SYSTEMS picks an interval below it: at LEASE_INTERVAL_S=15 this 30s would let a hung renewal
# occupy the next two ticks, which is exactly the recovery guarantee LEASE-HEARTBEAT.md §3
# claims. systemd cannot read it from the EnvironmentFile, so the installer must write it.
TimeoutStartSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/desk-lease-heartbeat
StandardOutput=journal
StandardError=journal
SyslogIdentifier=desk-lease-heartbeat
