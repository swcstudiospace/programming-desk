# desk-gateway environment — template. The live file is /etc/desk-gateway/gateway.env
# (root:root 0600, never committed; install.sh copies this there once and never overwrites it).
# Every variable the gateway reads is listed; leave a value empty to leave that upstream unconfigured.
# Tailnet hosts (plan §5) are the *-tailscale-forwarder MagicDNS names, never Railway public domains.

# --- Listener ---------------------------------------------------------------
PUBLIC_HOST=desk.swcstudio.space
HOST=127.0.0.1
PORT=8791
DATA_DIR=/var/lib/desk-gateway
LOG_LEVEL=INFO

# --- Desk repo (read by desk_* tools; the gateway never pushes) --------------
DESK_REPO_DIR=/root/src/repos/programming-desk
DESK_REPO_REMOTE=origin

# --- Seat auth --------------------------------------------------------------
# Consent-page passphrase per seat. The same value is accepted as the x-connector-key
# header for that seat (smoke tests only; Bots connect with OAuth). One per seat, all distinct.
SEAT_PASSPHRASE_LEAD=
SEAT_PASSPHRASE_SYSTEMS=
SEAT_PASSPHRASE_WEB=
SEAT_PASSPHRASE_ANDROID=
SEAT_PASSPHRASE_IOS=
SEAT_PASSPHRASE_INFRA=
SEAT_PASSPHRASE_QUALITY=

# --- Intake (POST /v1/intake, plan §10) --------------------------------------
# Comma-separated origin:token pairs, e.g. github:...,slack:...,recruitment-desk:...,cron:...
# Seat tokens are refused on this route; only these origin tokens are accepted.
INTAKE_TOKENS=

# --- Local upstreams (same VPS) ---------------------------------------------
SUBSTRATE_URL=http://127.0.0.1:7410
# Substrate bearer minted for the desk gateway (SUBSTRATE_TOKEN_DESK_GATEWAY on the substrate side).
SUBSTRATE_TOKEN=
AGENT_BUS_URL=http://127.0.0.1:8790
AGENT_BUS_TOKEN=

# --- Data planes over the tailnet (plan §5, §6) -------------------------------
# Greptime: audit events (agent_events). http://ultrathink-production-tailscale-forwarder:4000
GREPTIME_URL=
GREPTIME_USER=
GREPTIME_PASSWORD=
GREPTIME_DB=public
# Timescale: intake queue, claims, idempotency, receipts.
# postgresql://…@ultrathink-production-tailscale-forwarder:5432/railway
SUBSTRATE_PG_URL=
# Dragonfly: cache only; every read falls through when it is unreachable.
# redis://…@ultrathink-production-tailscale-forwarder:6379
DRAGONFLY_URL=
# Hindsight: memory banks pd-*. http://agent-substrate-production-tailscale-forwarder:8888
HINDSIGHT_URL=
HINDSIGHT_API_KEY=
# RAGFlow: docs datasets. http://agent-substrate-production-tailscale-forwarder:9380
RAGFLOW_URL=
RAGFLOW_API_KEY=

# --- Platform APIs (seat tools) ----------------------------------------------
RAILWAY_API_TOKEN=
# Project ids, not names.
RAILWAY_PROJECT_ULTRATHINK=
RAILWAY_PROJECT_AGENT_SUBSTRATE=
VERCEL_TOKEN=
VERCEL_TEAM_ID=
# Comma-separated allowlist of Vercel project names the WEB seat may touch.
VERCEL_PROJECTS=
GREPTILE_API_KEY=
GREPTILE_GITHUB_TOKEN=
GITHUB_TOKEN=
# Short-lived OAuth access token minted by an operator script from the Play service account.
# Empty = Play tools report "not configured" instead of failing.
PLAY_ACCESS_TOKEN=
ASC_KEY_ID=
ASC_ISSUER_ID=
ASC_PRIVATE_KEY_PATH=

# --- Tool packs (plan §7.4): product API bases the mobile/web seats call -------
PACK_KANBANOS_API_BASE=
PACK_DESKLANES_API_BASE=
PACK_CLIPPYOS_API_BASE=
