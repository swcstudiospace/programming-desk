# substrate-mcp environment — template. The live file is /etc/substrate/substrate.env
# (root:root 0600, never committed, never templated into a repo or a prompt).
#
# NAMES ONLY. Every value here is empty on purpose: this file says which variable exists and
# which process reads it, and an empty value means "not configured" rather than "configured
# wrong". Placement rules and the GREPTIME_URL preference order: SUBSTRATE-ENV.md, beside
# this file.
#
# Tailnet hosts are the *-tailscale-forwarder MagicDNS names from ../railway/forwarders.yaml,
# never Railway public domains and never *.railway.internal (which does not resolve from the VPS).

# --- Listener ----------------------------------------------------------------
# Loopback only: the desk gateway is the client, over 127.0.0.1.
SUBSTRATE_HOST=127.0.0.1
SUBSTRATE_PORT=7410
SUBSTRATE_LOG_LEVEL=INFO
# One bearer per consumer, so a rotation does not take every caller down at once.
SUBSTRATE_TOKEN_DESK_GATEWAY=

# --- Events plane: GreptimeDB agent_events (SPE-4789, SPE-4793) ---------------
# Append-only. Preferred once the forwarder is live:
#   GREPTIME_URL=http://ultrathink-production-tailscale-forwarder:4000
# Current stable fallback, and what is placed on the VPS today (the tailnet route is reachable
# but produced a substrate-mcp startup timeout — see the receipts named in SUBSTRATE-ENV.md §3):
#   GREPTIME_URL=https://<greptime-public-railway-domain>   + Basic auth below
GREPTIME_URL=
GREPTIME_USER=
GREPTIME_PASSWORD=
GREPTIME_DB=public

# --- Index plane: TimescaleDB (intake queue, claims, idempotency, receipts) ---
# postgresql://…@ultrathink-production-tailscale-forwarder:5432/railway
SUBSTRATE_PG_URL=

# --- Cache plane: Dragonfly (cache only; every read falls through when down) --
# redis://…@ultrathink-production-tailscale-forwarder:6379
DRAGONFLY_URL=

# --- Memory plane: Hindsight banks pd-* --------------------------------------
# http://agent-substrate-production-tailscale-forwarder:8888
HINDSIGHT_URL=
HINDSIGHT_API_KEY=

# --- Documents plane: RAGFlow datasets ---------------------------------------
# http://agent-substrate-production-tailscale-forwarder:9380
RAGFLOW_URL=
RAGFLOW_API_KEY=

# --- Cutover placeholders: OTEL (SUBSTRATE-ENV.md §4.1) ----------------------
# Standard OpenTelemetry SDK names so no bespoke mapping layer is needed.
# OTEL_EXPORTER_OTLP_HEADERS carries a credential when the collector authenticates.
OTEL_SDK_DISABLED=
OTEL_SERVICE_NAME=
OTEL_RESOURCE_ATTRIBUTES=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_TRACES_SAMPLER=
OTEL_TRACES_SAMPLER_ARG=
OTEL_METRICS_EXPORTER=
OTEL_LOGS_EXPORTER=

# --- Cutover placeholders: MCP audit (SUBSTRATE-ENV.md §4.2) -----------------
# ARGS_MODE defaults to a redacted hash of the arguments, not the arguments themselves.
MCP_AUDIT_ENABLED=
MCP_AUDIT_SINK=
MCP_AUDIT_TABLE=
MCP_AUDIT_ARGS_MODE=
MCP_AUDIT_REDACT=
MCP_AUDIT_SAMPLE_RATE=
MCP_AUDIT_QUEUE_MAX=
MCP_AUDIT_FLUSH_INTERVAL_S=

# --- Cutover placeholders: evidence (SUBSTRATE-ENV.md §4.3) ------------------
# EVIDENCE_ANCHOR_KEY_PATH is a path. A signing key never becomes an environment value.
EVIDENCE_DIR=
EVIDENCE_RECEIPTS_DIR=
EVIDENCE_RETENTION_DAYS=
EVIDENCE_ANCHOR_ENABLED=
EVIDENCE_ANCHOR_INTERVAL_S=
EVIDENCE_ANCHOR_CHAIN=
EVIDENCE_ANCHOR_RPC_URL=
EVIDENCE_ANCHOR_KEY_PATH=
